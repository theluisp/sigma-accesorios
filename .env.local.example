# Copia este archivo a .env.local y llena los valores reales.
# .env.local NUNCA debe subirse a git (ya está en .gitignore).

APP_SECRET=

GOOGLE_SHEETS_SPREADSHEET_ID=
# Deja el path por defecto si pones el JSON en config/google/service-account.json
# GOOGLE_SHEETS_CREDENTIALS_PATH=config/google/service-account.json
# Solo si el nombre real de las pestañas en el Sheet es distinto al de .env:
# GOOGLE_SHEETS_RANGE_REAL_DE_GUADALUPE="'REAL DE GUADALUPE'!A2:L"
# GOOGLE_SHEETS_RANGE_CAPU="'CAPU'!A2:L"

# Genera con: php bin/console security:hash-password
ADMIN_PASSWORD_HASH=

WHATSAPP_PHONE_NUMBER=
WHATSAPP_API_TOKEN=
