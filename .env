# En producción NO uses este archivo, define las variables de entorno reales
# en el servidor. Este .env es la base con valores por defecto para desarrollo.
#
# Documentación: https://symfony.com/doc/current/configuration.html#overriding-environment-values-via-env-local

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_generate_a_real_secret
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# SQLite por default: cero setup, un solo archivo en var/data.db (ya está en .gitignore vía /var/).
# Para usar MySQL en vez de SQLite, sobreescribe esto en .env.local, ej.:
# DATABASE_URL="mysql://usuario:password@127.0.0.1:3306/sigma_accesorios?serverVersion=8.0"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> sigma/catalogo (Google Sheets) ###
# Setup completo en docs/google-sheets-setup.md
GOOGLE_SHEETS_SPREADSHEET_ID=
# Ruta relativa al proyecto (NO uses %kernel.project_dir% aquí, .env no lo resuelve).
GOOGLE_SHEETS_CREDENTIALS_PATH=config/google/service-account.json
# Nombres exactos de las pestañas del Sheet (confirmados con el usuario).
GOOGLE_SHEETS_RANGE_REAL_DE_GUADALUPE="'Real De Guadalupe Inventario'!A2:L"
GOOGLE_SHEETS_RANGE_CAPU="'Capu Inventario'!A2:L"
###< sigma/catalogo ###

###> sigma/admin (panel de imágenes) ###
# Usuario fijo "admin". Genera el hash con: php bin/console security:hash-password
# y pega el resultado en .env.local (NUNCA lo pongas aquí, en .env que sí se sube a git).
ADMIN_PASSWORD_HASH=
###< sigma/admin ###

###> sigma/whatsapp ###
# WHATSAPP_PHONE_NUMBER con lada país, solo dígitos — se usa para el botón/
# link "Escribir por WhatsApp" (wa.me). Es dato público del negocio (como
# RAPPI_URL abajo), por eso trae default aquí y no hace falta configurarlo
# en .env.local. Si cambia el número, sobreescríbelo en .env.local.
WHATSAPP_PHONE_NUMBER=522219220465
WHATSAPP_API_TOKEN=
###< sigma/whatsapp ###

###> sigma/contacto (redes y ubicación) ###
# Dato público del negocio (confirmado por el usuario), igual que RAPPI_URL
# abajo — por eso trae default aquí y no hace falta configurarlo en
# .env.local. Si cambia la página, sobreescríbelo en .env.local.
# Si FACEBOOK_URL queda vacío, ese botón simplemente no se muestra.
FACEBOOK_URL="https://www.facebook.com/profile.php?id=61555024547420"
RAPPI_URL="https://www.rappi.com.mx/tiendas/1930247758-sigmaaccesoriosparacelula-mt-enc/s?term=sigma%20accesorios"
# Texto de búsqueda en Google Maps (no un pin exacto — no tenemos la
# dirección/coordenadas confirmadas). Ajusta si quieres afinar la búsqueda.
MAPS_QUERY="Sigma Accesorios San Cristóbal de las Casas"
###< sigma/contacto ###
