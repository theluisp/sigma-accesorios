# En producción NO uses este archivo, define las variables de entorno reales
# en el servidor. Este .env es la base con valores por defecto para desarrollo.
#
# Documentación: https://symfony.com/doc/current/configuration.html#overriding-environment-values-via-env-local

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_generate_a_real_secret
###< symfony/framework-bundle ###

###> sigma/catalogo (Google Sheets) ###
# Se configurará cuando conectemos el catálogo al Google Sheet maestro.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_PATH=%kernel.project_dir%/config/google/service-account.json
CATALOG_CACHE_TTL=300
###< sigma/catalogo ###

###> sigma/whatsapp ###
# Se configurará cuando integremos el chat de WhatsApp.
WHATSAPP_PHONE_NUMBER=
WHATSAPP_API_TOKEN=
###< sigma/whatsapp ###
