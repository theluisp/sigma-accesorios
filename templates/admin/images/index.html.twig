{% extends 'base.html.twig' %}

{% block title %}Admin · Imágenes{% endblock %}

{% block body %}
    <h1>Imágenes de productos</h1>
    <nav class="admin-nav">
        <a href="{{ path('admin_images_index') }}" class="admin-nav__link admin-nav__link--active">Imágenes de productos</a>
        <a href="{{ path('admin_analiticas_index') }}" class="admin-nav__link">Analíticas</a>
    </nav>

    <p>{{ productos|length }} productos en la base de datos. Sube la foto de cada uno; se guarda con el nombre interno del producto (slug), así sirve para ambas sucursales si lo venden las dos.</p>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="admin-flash admin-flash--{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <table class="admin-table">
        <thead>
            <tr>
                <th>Imagen actual</th>
                <th>Producto</th>
                <th>Sucursales</th>
                <th>Subir nueva imagen</th>
            </tr>
        </thead>
        <tbody>
            {% for producto in productos %}
                <tr class="{{ producto.imagen ? 'admin-table__row--ok' : 'admin-table__row--pending' }}">
                    <td>
                        <img src="{{ producto.imagen ? producto.imagen.path : '/images/placeholder-product.svg' }}" alt="{{ producto.nombre }}" class="admin-table__thumb">
                    </td>
                    <td>
                        <strong>{{ producto.nombre }}</strong><br>
                        <code>{{ producto.slug }}</code>
                    </td>
                    <td>
                        {% for existencia in producto.existencias %}
                            {{ existencia.sucursal.nombre }}{{ not loop.last ? ', ' }}
                        {% endfor %}
                    </td>
                    <td>
                        <form action="{{ path('admin_images_upload', {slug: producto.slug}) }}" method="post" enctype="multipart/form-data" class="admin-upload-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('upload-image-' ~ producto.slug) }}">
                            <input type="file" name="imagen" accept="image/jpeg,image/png,image/webp" required>
                            <button type="submit" class="btn btn--primary btn--small">Subir</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
