{% extends 'base.html.twig' %}

{% block title %}Admin · Analíticas{% endblock %}

{% block body %}
    <h1>Analíticas del sitio</h1>
    <nav class="admin-nav">
        <a href="{{ path('admin_pedidos_index') }}" class="admin-nav__link">Pedidos</a>
        <a href="{{ path('admin_analiticas_index') }}" class="admin-nav__link admin-nav__link--active">Analíticas</a>
        <a href="{{ path('admin_images_index') }}" class="admin-nav__link">Imágenes de productos</a>
        <a href="{{ path('admin_categorias_index') }}" class="admin-nav__link">Categorías</a>
    </nav>

    <p class="admin-analiticas__nota">
        Conteo básico de visitas: cada navegador distinto se cuenta una sola vez por día
        (vía una cookie propia, sin guardar IP ni ningún otro dato personal). No es un
        análisis de tráfico completo, pero da una idea real de cuánta gente entra al sitio.
        Las visitas al propio panel de administración no se cuentan, y tampoco los bots
        (buscadores como Google, ni los previsualizadores de link de WhatsApp/Facebook/
        Telegram — compartir el link en un grupo ya NO infla el contador).
    </p>

    <div class="admin-stats">
        <div class="admin-stat-card admin-stat-card--highlight">
            <span class="admin-stat-card__label">Hoy</span>
            <span class="admin-stat-card__value">{{ hoy.contador }}</span>
        </div>
        <div class="admin-stat-card">
            <span class="admin-stat-card__label">Últimos {{ diasAMostrar }} días</span>
            <span class="admin-stat-card__value">{{ totalPeriodo }}</span>
        </div>
        <div class="admin-stat-card">
            <span class="admin-stat-card__label">Promedio diario</span>
            <span class="admin-stat-card__value">{{ promedioPeriodo }}</span>
        </div>
        <div class="admin-stat-card">
            <span class="admin-stat-card__label">Total histórico</span>
            <span class="admin-stat-card__value">{{ totalHistorico }}</span>
        </div>
    </div>

    <h2>Últimos {{ diasAMostrar }} días</h2>
    <div class="admin-chart">
        {% for dia in ultimosDias %}
            <div class="admin-chart__bar-wrap" title="{{ dia.fecha|date('d/m/Y') }}: {{ dia.contador }} visita{{ dia.contador == 1 ? '' : 's' }}">
                <div class="admin-chart__bar" style="height: {{ (dia.contador / maxContador * 100)|round(1) }}%"></div>
                <span class="admin-chart__day">{{ dia.fecha|date('d') }}</span>
            </div>
        {% endfor %}
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Visitas</th>
            </tr>
        </thead>
        <tbody>
            {% for dia in ultimosDias|reverse %}
                <tr>
                    <td>{{ dia.fecha|date('d/m/Y') }}</td>
                    <td>{{ dia.contador }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {# Páginas más visitadas (pedido explícito del usuario, sep 2026: "que
       es lo que mas visitan") — OJO, esto cuenta VISTAS (cada carga de
       página), no visitantes únicos como la tabla de arriba: si contara
       "una vez por navegador por día" como la de arriba, solo la primera
       página que abre cada quien sumaría (casi siempre Inicio), y el
       resto del sitio se vería en cero sin importar cuánto se visite de
       verdad — ver App\Entity\VisitaPagina. #}
    <h2>Páginas más visitadas</h2>
    <p class="admin-analiticas__nota">
        Cuenta cada carga de página (no navegadores únicos como la tabla de arriba),
        para poder comparar qué tanto se visita cada sección entre sí.
    </p>
    {% if paginasMasVisitadas is empty %}
        <p class="section__empty">Todavía no hay datos suficientes.</p>
    {% else %}
        <div class="admin-chart">
            {% for pagina in paginasMasVisitadas %}
                <div class="admin-chart__bar-wrap" title="{{ nombresRuta[pagina.ruta] ?? pagina.ruta }}: {{ pagina.contador }} vista{{ pagina.contador == 1 ? '' : 's' }}">
                    <div class="admin-chart__bar" style="height: {{ (pagina.contador / maxVistasPagina * 100)|round(1) }}%"></div>
                    <span class="admin-chart__day">{{ nombresRuta[pagina.ruta] ?? pagina.ruta }}</span>
                </div>
            {% endfor %}
        </div>

        <table class="admin-table">
            <thead>
                <tr>
                    <th>Página</th>
                    <th>Ruta</th>
                    <th>Vistas</th>
                    <th>Última visita</th>
                </tr>
            </thead>
            <tbody>
                {% for pagina in paginasMasVisitadas %}
                    <tr>
                        <td>{{ nombresRuta[pagina.ruta] ?? pagina.ruta }}</td>
                        <td><code>{{ pagina.ruta }}</code></td>
                        <td>{{ pagina.contador }}</td>
                        <td>{{ pagina.actualizadoEn|date('d/m/Y H:i') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
