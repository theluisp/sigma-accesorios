{% extends 'base.html.twig' %}

{% block title %}Sigma Accesorios para Celular{% endblock %}

{% block body_class %}is-home{% endblock %}

{% block body %}
    {% if banners is not empty %}
        <div id="home-carousel" class="carousel slide banner-carousel" data-bs-ride="carousel" data-bs-interval="5000">
            <div class="carousel-indicators">
                {% for banner in banners %}
                    <button
                        type="button"
                        data-bs-target="#home-carousel"
                        data-bs-slide-to="{{ loop.index0 }}"
                        class="{{ loop.first ? 'active' : '' }}"
                        aria-current="{{ loop.first ? 'true' : 'false' }}"
                        aria-label="Banner {{ loop.index }}"
                    ></button>
                {% endfor %}
            </div>
            <div class="carousel-inner">
                {% for banner in banners %}
                    <div class="carousel-item {{ loop.first ? 'active' : '' }}">
                        <div
                            class="banner-slide {{ banner.imagen is null ? 'banner-slide--' ~ banner.numero : '' }}"
                            {% if banner.imagen %}style="background-image: url('{{ banner.imagen }}')"{% endif %}
                        >
                            <div class="banner-slide__content">
                                <h2>{{ banner.titulo }}</h2>
                                <p>{{ banner.subtitulo }}</p>
                                {% if banner.ctaUrl %}
                                    <a
                                        href="{{ banner.ctaUrl }}"
                                        class="btn btn--primary"
                                        {% if banner.ctaExterna %}target="_blank" rel="noopener"{% endif %}
                                    >{{ banner.ctaTexto }}</a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#home-carousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Anterior</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#home-carousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Siguiente</span>
            </button>
        </div>
    {% endif %}

    {# Marcas: agrupa por palabra(s) clave en el NOMBRE del producto (no
       categorías de ProductCategorizer) — ver App\Service\Catalog\MarcaCatalog
       y App\Controller\HomeController::marcasParaMostrar(). Mismo criterio
       de "nunca una tarjeta vacía" que Categorías. Logos reales subidos
       por el usuario (public/images/brands/marca-<slug>.png, ya
       procesados a 320x320 parejo para que se vean del mismo tamaño) —
       cada tarjeta manda al Catálogo con el pseudo-filtro "marca-<slug>"
       (mismo mecanismo que Ofertas/Novedades, ver
       CatalogoController::MARCA_PREFIX), NO con una búsqueda de texto
       genérica — así los productos que aparecen coinciden exactamente con
       los que hicieron aparecer la tarjeta (ej. un producto que solo dice
       "Cable Lightning" en el título cuenta para Apple en ambos lados). #}
    {% if marcas is not empty %}
        <section class="section">
            <h2>Marcas</h2>
            <div class="categories-grid">
                {% for marca in marcas %}
                    <a href="{{ path('catalogo', {categoria: 'marca-' ~ marca.slug}) }}" class="category-card">
                        <span class="marca-card__logo">
                            <img src="/images/brands/marca-{{ marca.slug }}.png" alt="{{ marca.label }}" loading="lazy">
                        </span>
                        <span class="category-card__label">{{ marca.label }}</span>
                    </a>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {# Solo se listan categorías con producto disponible ahora mismo
       (App\Controller\HomeController::categoriasParaMostrar) — nunca una
       tarjeta que lleve a un catálogo vacío. #}
    {% if categorias is not empty %}
        {% set categoriaIconos = {
            'fundas': '_partials/_icon_case.svg.twig',
            'bocinas-audifonos': '_partials/_icon_audio.svg.twig',
            'cargadores': '_partials/_icon_charger.svg.twig',
            'soportes-auto': '_partials/_icon_stand.svg.twig',
            'soportes-moto': '_partials/_icon_stand.svg.twig',
            'adaptadores': '_partials/_icon_adapter.svg.twig',
            'hogar': '_partials/_icon_home.svg.twig',
            'videojuegos': '_partials/_icon_gamepad.svg.twig',
            'computacion': '_partials/_icon_computer.svg.twig',
            'chips': '_partials/_icon_chip.svg.twig',
            'otros': '_partials/_icon_other.svg.twig',
        } %}
        <section class="section">
            <h2>Categorías</h2>
            <div class="categories-grid">
                {% for categoria in categorias %}
                    <a href="{{ path('catalogo', {categoria: categoria.slug}) }}" class="category-card">
                        <span class="category-card__icon">{{ include(categoriaIconos[categoria.slug] ?? categoriaIconos['otros']) }}</span>
                        <span class="category-card__label">{{ categoria.label }}</span>
                    </a>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {# Destacados muestra SOLO productos con oferta real ahora mismo
       (ProductoRepository::findEnOferta — descuentoPorcentaje > 0 en el
       Sheet, nunca fabricado). Si hoy no hay ninguno en oferta, la sección
       se explica honestamente en vez de fingir que no hay fotos. #}
    <section class="section section--glass">
        <div class="section__header">
            <h2>Destacados</h2>
            <a href="{{ path('catalogo') }}" class="section__see-all">Ver todo el catálogo →</a>
        </div>
        <p class="section__subtitle">Nuestras mejores ofertas de hoy — precios más bajos, mientras dure el stock.</p>
        {% if productos is empty %}
            <p class="section__empty">
                Ahora mismo no tenemos productos en oferta, pero puedes ver
                <a href="{{ path('catalogo') }}">todo el catálogo aquí</a>
                {% if whatsapp_url() %}
                    o <a href="{{ whatsapp_url() }}" target="_blank" rel="noopener">preguntarnos por WhatsApp</a> por el mejor precio.
                {% else %}
                    .
                {% endif %}
            </p>
        {% else %}
            <div class="products-grid">
                {% for producto in productos %}
                    {{ include('_partials/_producto_card.html.twig', {producto: producto}) }}
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}
