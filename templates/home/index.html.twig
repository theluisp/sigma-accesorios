{% extends 'base.html.twig' %}

{% block title %}Sigma Accesorios{% endblock %}

{% block body %}
    <section class="hero">
        <div class="hero__text">
            <h1>Fundas, cargadores y más</h1>
            <p>Inventario actualizado en tiempo real. Encuentra el accesorio para tu modelo.</p>
            <a href="{{ path('catalogo') }}" class="btn btn--primary">Ver catálogo</a>
        </div>
        <div class="hero__media placeholder-box">
            {{ include('_partials/_icon_image.svg.twig') }}
        </div>
    </section>

    <section class="section">
        <h2>Categorías</h2>
        <div class="categories-grid">
            <a href="{{ path('catalogo', {categoria: 'fundas'}) }}" class="category-card">
                <span class="category-card__icon">{{ include('_partials/_icon_case.svg.twig') }}</span>
                <span class="category-card__label">Fundas</span>
            </a>
            <a href="{{ path('catalogo', {categoria: 'cargadores'}) }}" class="category-card">
                <span class="category-card__icon">{{ include('_partials/_icon_charger.svg.twig') }}</span>
                <span class="category-card__label">Cargadores</span>
            </a>
            <a href="{{ path('catalogo', {categoria: 'audio'}) }}" class="category-card">
                <span class="category-card__icon">{{ include('_partials/_icon_audio.svg.twig') }}</span>
                <span class="category-card__label">Audio</span>
            </a>
            <a href="{{ path('catalogo', {categoria: 'mica-vidrio'}) }}" class="category-card">
                <span class="category-card__icon">{{ include('_partials/_icon_shield.svg.twig') }}</span>
                <span class="category-card__label">Mica/vidrio</span>
            </a>
        </div>
    </section>

    <section class="section section--glass">
        <div class="section__header">
            <h2>Destacados</h2>
            <a href="{{ path('catalogo') }}" class="section__see-all">Ver todo el catálogo →</a>
        </div>
        {% if productos is empty %}
            <p class="section__empty">
                Todavía no hay productos con foto propia — súbelas desde
                <a href="/admin/imagenes">el panel de imágenes</a>.
            </p>
        {% else %}
            <div class="products-grid">
                {% for producto in productos %}
                    {{ include('_partials/_producto_card.html.twig', {producto: producto}) }}
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}
