{% extends 'base.html.twig' %}

{% block title %}Sigma Accesorios{% endblock %}

{% block body %}
    {% if banners is not empty %}
        <div id="home-carousel" class="carousel slide banner-carousel" data-bs-ride="carousel" data-bs-interval="5000">
            <div class="carousel-indicators">
                {% for banner in banners %}
                    <button
                        type="button"
                        data-bs-target="#home-carousel"
                        data-bs-slide-to="{{ loop.index0 }}"
                        class="{{ loop.first ? 'active' : '' }}"
                        aria-current="{{ loop.first ? 'true' : 'false' }}"
                        aria-label="Banner {{ loop.index }}"
                    ></button>
                {% endfor %}
            </div>
            <div class="carousel-inner">
                {% for banner in banners %}
                    <div class="carousel-item {{ loop.first ? 'active' : '' }}">
                        <div
                            class="banner-slide {{ banner.imagen is null ? 'banner-slide--' ~ banner.numero : '' }}"
                            {% if banner.imagen %}style="background-image: url('{{ banner.imagen }}')"{% endif %}
                        >
                            <div class="banner-slide__content">
                                <h2>{{ banner.titulo }}</h2>
                                <p>{{ banner.subtitulo }}</p>
                                {% if banner.ctaUrl %}
                                    <a
                                        href="{{ banner.ctaUrl }}"
                                        class="btn btn--primary"
                                        {% if banner.ctaExterna %}target="_blank" rel="noopener"{% endif %}
                                    >{{ banner.ctaTexto }}</a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#home-carousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Anterior</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#home-carousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Siguiente</span>
            </button>
        </div>
    {% endif %}

    <section class="section">
        <h2>Categorías</h2>
        <div class="categories-grid">
            <a href="{{ path('catalogo', {categoria: 'fundas'}) }}" class="category-card">
                <span class="category-card__icon">{{ include('_partials/_icon_case.svg.twig') }}</span>
                <span class="category-card__label">Fundas</span>
            </a>
            <a href="{{ path('catalogo', {categoria: 'cargadores'}) }}" class="category-card">
                <span class="category-card__icon">{{ include('_partials/_icon_charger.svg.twig') }}</span>
                <span class="category-card__label">Cargadores</span>
            </a>
            <a href="{{ path('catalogo', {categoria: 'audio'}) }}" class="category-card">
                <span class="category-card__icon">{{ include('_partials/_icon_audio.svg.twig') }}</span>
                <span class="category-card__label">Audio</span>
            </a>
            <a href="{{ path('catalogo', {categoria: 'mica-vidrio'}) }}" class="category-card">
                <span class="category-card__icon">{{ include('_partials/_icon_shield.svg.twig') }}</span>
                <span class="category-card__label">Mica/vidrio</span>
            </a>
        </div>
    </section>

    <section class="section section--glass">
        <div class="section__header">
            <h2>Destacados</h2>
            <a href="{{ path('catalogo') }}" class="section__see-all">Ver todo el catálogo →</a>
        </div>
        {% if productos is empty %}
            <p class="section__empty">
                Todavía no hay productos con foto propia — súbelas desde
                <a href="/admin/imagenes">el panel de imágenes</a>.
            </p>
        {% else %}
            <div class="products-grid">
                {% for producto in productos %}
                    {{ include('_partials/_producto_card.html.twig', {producto: producto}) }}
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}
