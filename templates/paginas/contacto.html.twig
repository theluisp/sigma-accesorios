{% extends 'base.html.twig' %}

{% block title %}Contacto — Sigma Accesorios{% endblock %}

{% block body %}
    <section class="catalogo-header">
        <h1>Contacto</h1>
        <p>Escríbenos, síguenos o pide a domicilio — como prefieras.</p>
    </section>

    <section class="section">
        {% if whatsappUrl is not null %}
            <p class="contacto-incentivo">
               ¿Tienes dudas sobre un producto, tu pedido o quieres comprar directo?
                <a href="{{ whatsappUrl }}" target="_blank" rel="noopener">Escríbenos por WhatsApp</a> — respondemos rápido.
            </p>
        {% endif %}

        <div class="contacto-grid">
            {% if whatsappUrl is not null %}
                <a href="{{ whatsappUrl }}" target="_blank" rel="noopener" class="aqua-card contacto-card">
                    <span class="valor-icon contacto-icon--whatsapp">{{ include('_partials/_icon_whatsapp.svg.twig') }}</span>
                    <p class="aqua-card__name">WhatsApp</p>
                    <p class="valor-desc">Escríbenos directo, respondemos rápido.</p>
                </a>
            {% endif %}

            {% if rappiUrl is not null %}
                <a href="{{ rappiUrl }}" target="_blank" rel="noopener" class="aqua-card contacto-card">
                    <span class="contacto-logo">
                        <img src="/images/brands/rappi.png" alt="Rappi" loading="lazy">
                    </span>
                    <p class="aqua-card__name">Rappi</p>
                    <p class="valor-desc">Pide a domicilio da clic aqui.</p>
                </a>
            {% endif %}

            {# Didi Food no tiene un link directo de pedido (a diferencia de
               Rappi/WhatsApp) — antes esta tarjeta reusaba por error rappiUrl
               como href, así que el botón mandaba a Rappi en vez de a Didi.
               Ahora abre un modal con instrucciones (la app de Didi no tiene
               un deep link público a la tienda), así que no depende de
               ninguna URL de contacto y siempre se muestra. #}
            <button type="button" class="aqua-card contacto-card contacto-card--btn" data-bs-toggle="modal" data-bs-target="#didi-modal">
                <span class="contacto-logo">
                    <img src="/images/brands/didi.jpg" alt="didi" loading="lazy">
                </span>
                <p class="aqua-card__name">Didi Food</p>
                <p class="valor-desc">Pide a domicilio — ve cómo aquí.</p>
            </button>

            {# "Puntos de entrega" abre un modal con el póster de la campaña
               (lista completa de puntos de la zona norte/centro, punto
               nuevo de Gallito, etc. — imagen provista por el usuario, ago
               2026). Es información distinta a "Nuestras sucursales" de
               abajo (esa sigue viniendo de la BD vía #sucursales-modal). #}
            <button type="button" class="aqua-card contacto-card contacto-card--btn" data-bs-toggle="modal" data-bs-target="#puntos-entrega-modal">
                <span class="valor-icon">{{ include('_partials/_icon_pin.svg.twig') }}</span>
                <p class="aqua-card__name">Puntos de entrega</p>
                <p class="valor-desc">Consulta todos nuestros puntos de entrega.</p>
            </button>

            {% if whatsappUrl is not null %}
                <a href="{{ whatsappUrl }}?text={{ 'Hola, quiero cotizar el envío a domicilio de mi pedido.'|url_encode }}" target="_blank" rel="noopener" class="aqua-card contacto-card">
                    <span class="valor-icon">{{ include('_partials/_icon_truck.svg.twig') }}</span>
                    <p class="aqua-card__name">Envío a domicilio</p>
                    <p class="valor-desc">Nosotros te lo enviamos — cotiza por WhatsApp.</p>
                </a>
            {% endif %}

            {% if sucursales is not empty %}
                <button type="button" class="aqua-card contacto-card contacto-card--btn" data-bs-toggle="modal" data-bs-target="#sucursales-modal">
                    <span class="valor-icon">{{ include('_partials/_icon_home.svg.twig') }}</span>
                    <p class="aqua-card__name">Nuestras sucursales</p>
                    <p class="valor-desc">Contamos con sucursal cerca de Capu y otra cerca de la Central de Abastos.</p>
                </button>
            {% endif %}

            {% if facebookUrl is not null %}
                <a href="{{ facebookUrl }}" target="_blank" rel="noopener" class="aqua-card contacto-card">
                    <span class="contacto-logo contacto-logo--facebook">
                        <img src="/images/brands/facebook.png" alt="Facebook" loading="lazy">
                    </span>
                    <p class="aqua-card__name">Facebook</p>
                    <p class="valor-desc">Síguenos para ver novedades y promociones.</p>
                </a>
            {% endif %}
        </div>

        {% if facebookUrl is null %}
            <p class="section__empty contacto-pendiente">
                El botón de Facebook todavía no aparece porque falta configurar
                <code>FACEBOOK_URL</code> en <code>.env.local</code>.
            </p>
        {% endif %}


    </section>

    {# Modal con instrucciones para pedir por Didi Food: la app no tiene un
       link directo a la tienda, así que en vez de un botón roto se explica
       en 2 pasos cómo encontrarnos dentro de la app (capturas de pantalla
       provistas por el usuario). #}
    <div class="modal fade" id="didi-modal" tabindex="-1" aria-labelledby="didi-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content aqua-modal">
                <div class="modal-header">
                    <h5 class="modal-title" id="didi-modal-title">Pide por Didi Food</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="didi-paso">
                        <p class="didi-paso__titulo">
                            <span class="didi-paso__numero">1</span>
                            Abre la app de DiDi y da clic en la sección Shop
                        </p>
                        <img src="/images/didi/paso-1.png" alt="Paso 1: abrir la sección Shop en la app de DiDi" loading="lazy">
                    </div>
                    <div class="didi-paso">
                        <p class="didi-paso__titulo">
                            <span class="didi-paso__numero">2</span>
                            Busca "Sigma Accesorios Para Celular" y realiza tu pedido
                        </p>
                        <img src="/images/didi/paso-2.png" alt="Paso 2: buscar Sigma Accesorios Para Celular en DiDi" loading="lazy">
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Modal de "Puntos de entrega": muestra el póster completo de la
       campaña (imagen provista por el usuario, ago 2026) con todos los
       puntos de entrega de la zona norte/centro y el punto nuevo de
       Gallito. Es una sola imagen estática (no viene de la BD, a
       diferencia de #sucursales-modal), así que si algún día cambian los
       puntos hay que subir un póster nuevo a
       public/images/entrega/puntos-entrega.jpg. #}
    <div class="modal fade" id="puntos-entrega-modal" tabindex="-1" aria-labelledby="puntos-entrega-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content aqua-modal">
                <div class="modal-header">
                    <h5 class="modal-title" id="puntos-entrega-modal-title">Puntos de entrega</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body modal-body--imagen">
                    <img src="/images/entrega/puntos-entrega.jpg" alt="Puntos de entrega Sigma Accesorios — zona norte y centro" loading="lazy">
                </div>
            </div>
        </div>
    </div>

    {# Modal de sucursales: lista las sucursales reales (SucursalRepository).
       Ya NO enlaza a Google Maps (pedido explícito del usuario: quitar las
       direcciones de Maps) — antes cada una era un link a
       ContactoLinks::mapsUrlPara(), que de todos modos era solo una
       búsqueda por texto, no un pin exacto. El método sigue existiendo en
       ContactoLinks por si se retoma más adelante con coordenadas reales,
       pero la plantilla ya no lo usa. #}
    {% if sucursales is not empty %}
        <div class="modal fade" id="sucursales-modal" tabindex="-1" aria-labelledby="sucursales-modal-title" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content aqua-modal">
                    <div class="modal-header">
                        <h5 class="modal-title" id="sucursales-modal-title">Nuestras sucursales</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <p class="sucursales-modal__intro">Recoge tu pedido o visítanos en cualquiera de nuestras sucursales:</p>
                        <div class="sucursales-lista">
                            {% for sucursal in sucursales %}
                                <div class="sucursal-item">
                                    <span class="valor-icon">{{ include('_partials/_icon_pin.svg.twig') }}</span>
                                    <span class="sucursal-item__nombre">{{ sucursal.nombre }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
