{#
    Tarjeta de producto reutilizable (Home/Destacados y Catálogo).
    Espera una variable `producto` (App\Entity\Producto) en el contexto.
#}
{% set precioTexto = producto.precioDesde is not null
    ? 'Desde $' ~ producto.precioDesde|number_format(0, '.', ',')
    : 'Consultar disponibilidad' %}
{% set imagenSrc = producto.imagen ? producto.imagen.path : '/images/placeholder-product.svg' %}
<div class="aqua-card">
    <div class="aqua-card__media">
        <img src="{{ imagenSrc }}" alt="{{ producto.nombre }}" loading="lazy">
    </div>
    <p class="aqua-card__name">{{ producto.nombre }}</p>
    <p class="aqua-card__price">{{ precioTexto }}</p>
    <button
        type="button"
        class="btn btn--primary btn--small"
        data-bs-toggle="modal"
        data-bs-target="#producto-modal"
        data-nombre="{{ producto.nombre }}"
        data-descripcion="{{ producto.descripcion|default('Sin descripción disponible.') }}"
        data-precio="{{ precioTexto }}"
        data-imagen="{{ imagenSrc }}"
    >
        Ver detalle
    </button>
</div>
