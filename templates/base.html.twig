<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Sigma Accesorios{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/app.css">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <header class="site-header">
        <div class="site-header__inner">
            <a href="{{ path('home') }}" class="site-header__brand">
                <img src="/images/logo.png" alt="Sigma Accesorios" class="site-header__logo">
            </a>
            <nav class="site-nav">
                <a href="#">Catálogo</a>
                <a href="#">Nosotros</a>
                <a href="#">Contacto</a>
            </nav>
        </div>
    </header>

    <main class="site-main">
        {% block body %}{% endblock %}
    </main>

    <footer class="site-footer">
        <p>&copy; {{ "now"|date("Y") }} Sigma Accesorios</p>
    </footer>

    <button type="button" class="chat-bubble" aria-label="Abrir chat">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
    </button>

    {# Modal genérico de "ver detalle" de producto (componente Modal de Bootstrap,
       con el vestido Aqua en app.css). Cualquier botón con
       data-bs-toggle="modal" data-bs-target="#producto-modal" y los atributos
       data-nombre/data-descripcion/data-precio/data-imagen lo abre y lo llena
       (ver public/js/app.js). Reutilizable desde Home, Catálogo, etc. #}
    <div class="modal fade" id="producto-modal" tabindex="-1" aria-labelledby="producto-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content aqua-modal">
                <div class="modal-header">
                    <h5 class="modal-title" id="producto-modal-title"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="aqua-modal__media mb-3">
                        <img id="producto-modal-imagen" src="" alt="">
                    </div>
                    <p class="aqua-modal__price fw-bold" id="producto-modal-precio"></p>
                    <p class="aqua-modal__descripcion" id="producto-modal-descripcion"></p>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script src="/js/app.js" defer></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
