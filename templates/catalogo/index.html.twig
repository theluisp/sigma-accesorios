{% extends 'base.html.twig' %}

{% block title %}{{ metaTitulo }}{% endblock %}
{% block metaDescription %}{{ metaDescripcion }}{% endblock %}

{% block body %}
    <section class="catalogo-header">
        <h1>Catálogo</h1>
        <p>Explora todo nuestro inventario.</p>

        <form method="get" action="{{ path('catalogo') }}" class="catalogo-search" role="search">
            {% if categoriaSeleccionada is not empty %}
                <input type="hidden" name="categoria" value="{{ categoriaSeleccionada }}">
            {% endif %}
            <span class="catalogo-search__icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="7"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </span>
            <input
                type="search"
                name="q"
                value="{{ texto }}"
                placeholder="Busca por nombre, ej. 'cargador iphone'…"
                class="catalogo-search__input"
                aria-label="Buscar productos"
            >
            <button type="submit" class="btn btn--primary btn--small catalogo-search__btn">Buscar</button>
        </form>
    </section>

    <section class="section">
        {# categoriaLabel ya viene resuelto desde CatalogoController (incluye
           el caso de un pseudo-filtro de marca, ej. "marca-apple" → "Apple",
           ver MarcaCatalog) — no se recalcula aquí. #}
        <div class="category-pills">
            <a
                href="{{ path('catalogo', {q: texto, categoria: ''}) }}#catalogo-resultados"
                class="category-pill{{ categoriaSeleccionada is empty ? ' category-pill--active' : '' }}"
            >
                Todos <span class="category-pill__count">{{ totalEnBusqueda }}</span>
            </a>
            {% if conteoNovedades > 0 %}
                {# Pila de "Novedades": tampoco es una categoría real de
                   ProductCategorizer — es un pseudo-filtro por fecha de alta
                   (ver CatalogoController::NOVEDADES_SLUG/NOVEDADES_DIAS),
                   solo se muestra si hay al menos un producto agregado en los
                   últimos NOVEDADES_DIAS días. #}
                <a
                    href="{{ path('catalogo', {q: texto, categoria: novedadesSlug}) }}#catalogo-resultados"
                    class="category-pill category-pill--novedades{{ categoriaSeleccionada == novedadesSlug ? ' category-pill--active' : '' }}"
                >
                    ✨ Novedades <span class="category-pill__count">{{ conteoNovedades }}</span>
                </a>
            {% endif %}
            {% if conteoOfertas > 0 %}
                {# Pila de "Ofertas": no es una categoría real de ProductCategorizer,
                   es un pseudo-filtro (ver CatalogoController::OFERTAS_SLUG) que
                   solo se muestra cuando hay al menos un producto en oferta ahora
                   mismo — nunca lleva a un catálogo vacío. #}
                <a
                    href="{{ path('catalogo', {q: texto, categoria: ofertasSlug}) }}#catalogo-resultados"
                    class="category-pill category-pill--ofertas{{ categoriaSeleccionada == ofertasSlug ? ' category-pill--active' : '' }}"
                >
                    🔥 Ofertas <span class="category-pill__count">{{ conteoOfertas }}</span>
                </a>
            {% endif %}
        </div>

        {# Categorías reales de ProductCategorizer: antes eran píldoras de
           texto igual que Todos/Ofertas/Novedades, luego tarjetas con
           ícono en grilla (ago 2026) — se movieron aquí desde Home (donde
           antes vivía este mismo carrusel de categorías, ver
           App\Controller\HomeController) porque el Catálogo es donde de
           verdad se filtra. Al usuario no le gustó cómo se veía la grilla
           de tarjetas (ni achicada), así que ahora es un riel horizontal
           de íconos circulares con scroll (.categoria-chip, sep 2026).
           Soportes para auto/moto usan íconos propios (auto/moto) en vez
           de compartir un ícono de "soporte" genérico. #}
        {% set categoriaIconos = {
            'fundas': '_partials/_icon_case.svg.twig',
            'bocinas-audifonos': '_partials/_icon_audio.svg.twig',
            'cargadores': '_partials/_icon_charger.svg.twig',
            'soportes-auto': '_partials/_icon_car.svg.twig',
            'soportes-moto': '_partials/_icon_motorcycle.svg.twig',
            'adaptadores': '_partials/_icon_adapter.svg.twig',
            'hogar': '_partials/_icon_home.svg.twig',
            'videojuegos': '_partials/_icon_gamepad.svg.twig',
            'computacion': '_partials/_icon_computer.svg.twig',
            'chips': '_partials/_icon_chip.svg.twig',
            'otros': '_partials/_icon_other.svg.twig',
        } %}
        <div class="categorias-rail catalogo-categorias">
            {% for slug, label in categorias %}
                <a
                    href="{{ path('catalogo', {q: texto, categoria: slug}) }}#catalogo-resultados"
                    class="categoria-chip{{ categoriaSeleccionada == slug ? ' categoria-chip--active' : '' }}"
                >
                    <span class="categoria-chip__icono">{{ include(categoriaIconos[slug] ?? categoriaIconos['otros']) }}</span>
                    <span class="categoria-chip__label">{{ label }}</span>
                    <span class="categoria-chip__count">{{ conteoPorCategoria[slug] ?? 0 }}</span>
                </a>
            {% endfor %}
        </div>

        {# Ancla para que al dar clic en un filtro (píldora o tarjeta de
           categoría) el navegador baje solo hasta aquí — pedido explícito
           del usuario, ago 2026: sin esto, después de recargar la página
           filtrada, el usuario aterriza arriba del todo (en el buscador) y
           puede parecer que el clic no hizo nada, porque los resultados
           quedan más abajo sin que se note el cambio. #}
        <p class="catalogo-meta" id="catalogo-resultados">
            {% if texto is not empty %}
                {{ totalResultados }} resultado{{ totalResultados == 1 ? '' : 's' }} para «{{ texto }}»
                {%- if categoriaSeleccionada is not empty %} en {{ categoriaLabel }}{% endif %}
            {% else %}
                {{ totalResultados }} producto{{ totalResultados == 1 ? '' : 's' }}
                {%- if categoriaSeleccionada is not empty %} en {{ categoriaLabel }}{% endif %}
            {% endif %}
        </p>

        {% if productos is empty %}
            <p class="section__empty">
                No encontramos productos con esos filtros.
                <a href="{{ path('catalogo') }}">Quitar filtros</a>
                {% if whatsapp_url() %}
                    o <a href="{{ whatsapp_url() }}" target="_blank" rel="noopener">pregúntanos por WhatsApp</a>, seguro te ayudamos a encontrarlo.
                {% endif %}
            </p>
        {% else %}
            <div class="products-grid">
                {% for producto in productos %}
                    {{ include('_partials/_producto_card.html.twig', {producto: producto}) }}
                {% endfor %}
            </div>

            {% if totalPaginas > 1 %}
                <nav class="pagination-glass" aria-label="Paginación del catálogo">
                    <a
                        href="{{ path('catalogo', {q: texto, categoria: categoriaSeleccionada, pagina: max(pagina - 1, 1)}) }}"
                        class="pagination-glass__item{{ pagina <= 1 ? ' pagination-glass__item--disabled' : '' }}"
                        aria-label="Página anterior"
                    >&larr;</a>

                    {% for item in rangoPaginas %}
                        {% if item is null %}
                            <span class="pagination-glass__ellipsis">…</span>
                        {% else %}
                            <a
                                href="{{ path('catalogo', {q: texto, categoria: categoriaSeleccionada, pagina: item}) }}"
                                class="pagination-glass__item{{ item == pagina ? ' pagination-glass__item--active' : '' }}"
                            >{{ item }}</a>
                        {% endif %}
                    {% endfor %}

                    <a
                        href="{{ path('catalogo', {q: texto, categoria: categoriaSeleccionada, pagina: min(pagina + 1, totalPaginas)}) }}"
                        class="pagination-glass__item{{ pagina >= totalPaginas ? ' pagination-glass__item--disabled' : '' }}"
                        aria-label="Página siguiente"
                    >&rarr;</a>
                </nav>
            {% endif %}
        {% endif %}
    </section>
{% endblock %}
