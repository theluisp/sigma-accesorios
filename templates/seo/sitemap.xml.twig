<?xml version="1.0" encoding="UTF-8"?>
{# Solo las páginas "de verdad" (no las combinaciones de filtros del
   Catálogo con ?categoria=/?q=/?pagina= — esas se descubren solas por los
   links internos, no hace falta forzarlas aquí) y nunca /admin (ver
   robots.txt).

   xmlns:image (SEO sep 2026): permite listar varias <image:image> bajo
   una misma <url> — se usa en la entrada del Catálogo para que Google
   Imágenes indexe la foto de cada producto disponible, aunque todas
   compartan la misma URL de página (el Catálogo no tiene página propia
   por producto todavía). #}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
    <url>
        <loc>{{ url('home') }}</loc>
        <changefreq>daily</changefreq>
        <priority>1.0</priority>
    </url>
    <url>
        <loc>{{ url('catalogo') }}</loc>
        <changefreq>daily</changefreq>
        <priority>0.9</priority>
        {% if ultimaActualizacion %}<lastmod>{{ ultimaActualizacion|date('c') }}</lastmod>{% endif %}
        {% for producto in productos %}
            <image:image>
                <image:loc>{{ app.request.schemeAndHttpHost }}{{ producto.imagen.path }}</image:loc>
                <image:title>{{ producto.nombre }}</image:title>
            </image:image>
        {% endfor %}
    </url>
    <url>
        <loc>{{ url('contacto') }}</loc>
        <changefreq>monthly</changefreq>
        <priority>0.6</priority>
    </url>
    <url>
        <loc>{{ url('nosotros') }}</loc>
        <changefreq>monthly</changefreq>
        <priority>0.5</priority>
    </url>
    {# Faltaba (SEO, sep 2026): /negocios es una página real e indexable
       (cross-promoción de los otros negocios de Luis), simplemente se
       quedó fuera cuando se armó el sitemap la primera vez. Prioridad baja
       porque no es contenido del catálogo — es informativa. #}
    <url>
        <loc>{{ url('negocios') }}</loc>
        <changefreq>monthly</changefreq>
        <priority>0.3</priority>
    </url>
</urlset>
